{
  "name": "ai-asset-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Windows local asset manager for images, animations, videos, tags, colors, and prompts.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.3.0",
    "wait-on": "^9.0.3"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
